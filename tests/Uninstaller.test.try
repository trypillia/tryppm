load "../src/Uninstaller.try";
use TrypPM.Core.Uninstaller;

let originalOsExec = OS.exec;
let originalOsExit = OS.exit;
let originalFileExists = File.exists;
let originalFileOpen = File.open;

let globalWrittenData = "";
let exitCalled = false;

class MockResult {
    let isOk;
    let value;
    fn init(isOk, value) {
        this.isOk = isOk;
        this.value = value;
    }
}

class MockFileRead {
    fn read() {
        let manifest = {
            "name": "test-pkg",
            "dependencies": {
                "github:test/repo": "1.0.0"
            }
        };
        return MockResult(true, Json.stringify(manifest));
    }
    fn close() {}
}

class MockFileWrite {
    let path;
    fn init(path) {
        this.path = path;
    }
    fn write(data) {
        if (this.path == "tryp.json") {
            globalWrittenData = globalWrittenData + data;
        }
    }
    fn close() {}
}

describe("Uninstaller", fn() {
    let mockExecLog = [];
    
    beforeEach(fn() {
        mockExecLog = [];
        globalWrittenData = "";
        exitCalled = false;
        
        OS.exec = fn(cmd) {
            List.push(mockExecLog, cmd);
            return MockResult(true, "");
        };
        
        OS.exit = fn(code) {
            exitCalled = true;
            return;
        };

        File.exists = fn(path) {
            return path == "tryp.json"; // exists for uninstaller
        };

        File.open = fn(path, mode) {
            if (mode == "w") {
                return MockResult(true, MockFileWrite(path));
            } else {
                return MockResult(true, MockFileRead());
            }
        };
    });
    
    afterEach(fn() {
        OS.exec = originalOsExec;
        OS.exit = originalOsExit;
        File.exists = originalFileExists;
        File.open = originalFileOpen;
    });
    
    it("should remove package from tryp.json and delete directory", fn() {
        let uninstaller = Uninstaller();
        
        // This will call Installer().installManifest() at the end,
        // which will also read the same tryp.json mock and try to install 
        // whatever dependencies are in our read() mock.
        // Since our read() mock still returns the package (because we didn't update it),
        // Installer will try to install it. But OS.exec is mocked, so it's fine.
        
        uninstaller.uninstallPackage("github:test/repo");
        
        assertEq(exitCalled, false);
        assert(String.length(globalWrittenData) > 0);
        
        let newManifest = Json.parse(globalWrittenData);
        assertEq(Map.has(newManifest["dependencies"], "github:test/repo"), false);
        
        assertEq(mockExecLog[0], "rm -rf tryp_modules/repo");
    });
    
    it("should exit if tryp.json is missing", fn() {
        File.exists = fn(path) { return false; };
        
        let uninstaller = Uninstaller();
        uninstaller.uninstallPackage("github:test/repo");
        
        assertEq(exitCalled, true);
    });

    it("should exit if tryp.json cannot be read", fn() {
        File.open = fn(path, mode) {
            class MockFileReadError {
                fn read() { return MockResult(false, ""); }
                fn close() {}
            }
            return MockResult(true, MockFileReadError());
        };
        
        let uninstaller = Uninstaller();
        uninstaller.uninstallPackage("github:test/repo");
        
        assertEq(exitCalled, true);
    });
});
