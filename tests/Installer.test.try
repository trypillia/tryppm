load "../src/Installer.try";
use TrypPM.Core.Installer;

class MockResult {
    let isOk;
    let value;
    fn init(isOk, value) {
        this.isOk = isOk;
        this.value = value;
    }
}

class MockFileRead {
    let path;
    fn init(path) {
        this.path = path;
    }
    fn read() {
        if (this.path == "tryp.json") {
            let manifest = {
                "name": "test-pkg",
                "dependencies": {
                    "github:test/repo": "1.0.0",
                    "local:../some/path": "1.0.0"
                }
            };
            return MockResult(true, Json.stringify(manifest));
        } else if (this.path == "tryp_modules/repo/tryp.json") {
            let depManifest = {
                "name": "repo",
                "dependencies": {
                    "github:test/sub-repo": "2.0.0"
                }
            };
            return MockResult(true, Json.stringify(depManifest));
        } else if (this.path == "tryp_modules/path/tryp.json" || this.path == "tryp_modules/sub-repo/tryp.json") {
            return MockResult(true, "{}");
        }
        return MockResult(false, "");
    }
    fn close() {}
}

class MockFileWrite {
    let path;
    let writeCb;
    fn init(path, writeCb) {
        this.path = path;
        this.writeCb = writeCb;
    }
    fn write(data) {
        this.writeCb(this.path, data);
    }
    fn close() {}
}

let originalOsExec = OS.exec;
let originalOsExit = OS.exit;
let originalFileExists = File.exists;
let originalFileOpen = File.open;
let originalHttpGet = Http.get;

describe("Installer", fn() {
    let mockExecLog = [];
    let globalWrittenData = [];
    let exitCalled = false;
    
    beforeEach(fn() {
        mockExecLog = [];
        globalWrittenData = [];
        exitCalled = false;
        
        OS.exec = fn(cmd) {
            List.push(mockExecLog, cmd);
            return MockResult(true, "");
        };
        
        OS.exit = fn(code) {
            exitCalled = true;
            return;
        };

        File.exists = fn(path) {
            // Assume tryp.json exists everywhere we ask in tests
            return true;
        };

        File.open = fn(path, mode) {
            if (mode == "w") {
                let writeCb = fn(p, data) {
                    List.push(globalWrittenData, p);
                    List.push(globalWrittenData, data);
                };
                return MockResult(true, MockFileWrite(path, writeCb));
            } else {
                return MockResult(true, MockFileRead(path));
            }
        };
        
        Http.get = fn(url) {
            // Minimal mock for GitHubProvider used in installManifest
            if (url == "https://api.github.com/repos/test/repo/tags") {
                return MockResult(true, Json.stringify([{"name": "v1.0.0"}]));
            } else if (url == "https://api.github.com/repos/test/sub-repo/tags") {
                return MockResult(true, Json.stringify([{"name": "v2.0.0"}]));
            }
            return MockResult(false, "");
        };
    });
    
    afterEach(fn() {
        OS.exec = originalOsExec;
        OS.exit = originalOsExit;
        File.exists = originalFileExists;
        File.open = originalFileOpen;
        Http.get = originalHttpGet;
    });
    
    it("should resolve dependencies and generate autoloader", fn() {
        let installer = Installer();
        installer.installManifest();
        
        assertEq(exitCalled, false);
        
        let len = List.length(mockExecLog);
        assert(len > 0);
        
        let fullData = globalWrittenData[1];
        
        assert(String.length(fullData) > 0);
        assert(String.indexOf(fullData, "load \"sub-repo/main.try\";") >= 0);
        assert(String.indexOf(fullData, "load \"repo/main.try\";") >= 0);
        assert(String.indexOf(fullData, "load \"path/main.try\";") >= 0);
    });
    
    it("should exit if tryp.json is missing", fn() {
        File.exists = fn(path) { return false; };
        
        let installer = Installer();
        installer.installManifest();
        
        assertEq(exitCalled, true);
    });

    it("should exit if tryp.json cannot be read", fn() {
        File.open = fn(path, mode) {
            class MockFileReadError {
                fn read() { return MockResult(false, ""); }
                fn close() {}
            }
            return MockResult(true, MockFileReadError());
        };
        
        let installer = Installer();
        installer.installManifest();
        
        assertEq(exitCalled, true);
    });

    it("should exit if no dependencies found in tryp.json", fn() {
        File.open = fn(path, mode) {
            class MockFileReadNoDeps {
                fn read() {
                    let manifest = {"name": "test-pkg"};
                    return MockResult(true, Json.stringify(manifest));
                }
                fn close() {}
            }
            return MockResult(true, MockFileReadNoDeps());
        };
        
        let installer = Installer();
        installer.installManifest();
        
        assertEq(exitCalled, true);
    });

    it("should use replaceMap when installing dependencies", fn() {
        let installer = Installer();
        let deps = {"github:test/repo": "1.0.0"};
        let replaceMap = {"github:test/repo": "../local/path"};
        let installedMap = {};
        
        installer.installDeps(deps, replaceMap, installedMap);
        
        // It should resolve via LocalProvider to local:../local/path
        assertEq(Map.has(installedMap, "local:../local/path"), true);
    });

    it("should read replace block from manifest", fn() {
        File.open = fn(path, mode) {
            if (mode == "w") {
                let writeCb = fn(p, data) {
                    List.push(globalWrittenData, p);
                    List.push(globalWrittenData, data);
                };
                return MockResult(true, MockFileWrite(path, writeCb));
            } else {
                class MockFileReadWithReplace {
                    fn read() {
                        let manifest = {
                            "name": "test-pkg",
                            "dependencies": {"github:test/repo": "1.0.0"},
                            "replace": {"github:test/repo": "../local/path"}
                        };
                        return MockResult(true, Json.stringify(manifest));
                    }
                    fn close() {}
                }
                return MockResult(true, MockFileReadWithReplace());
            }
        };
        
        let installer = Installer();
        installer.installManifest();
        
        // Since installDeps is called, the globalWrittenData should contain "path/main.try"
        // Wait, folderName for "../local/path" is "path"
        let fullData = globalWrittenData[1];
        assert(String.indexOf(fullData, "load \"path/main.try\";") >= 0);
    });

    it("should exit on version conflict", fn() {
        let installer = Installer();
        let installedMap = {"github:test/repo": "1.0.0"};
        
        Http.get = fn(url) {
            return MockResult(true, Json.stringify([{"name": "v2.0.0"}]));
        };
        
        let replaceMap = {};
        installer._installWithProviders("github:test/repo", "*", replaceMap, installedMap);
        
        assertEq(exitCalled, true);
    });
});
