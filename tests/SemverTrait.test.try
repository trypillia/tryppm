load "../src/SemverTrait.try";
use TrypPM.Providers.SemverTrait;

class SemverHelper implements SemverTrait {
}

describe("SemverTrait", fn() {
    it("should extract semver correctly", fn() {
        let helper = SemverHelper();
        let ver1 = helper.extractSemver("v1.2.3");
        assertEq(ver1[0], 1);
        assertEq(ver1[1], 2);
        assertEq(ver1[2], 3);

        let ver2 = helper.extractSemver("2.0");
        assertEq(ver2[0], 2);
        assertEq(ver2[1], 0);
        assertEq(ver2[2], 0);
    });

    it("should satisfy caret and tilde constraints", fn() {
        let helper = SemverHelper();
        assertEq(helper.satisfies("v1.2.3", "^1.2.0"), true);
        assertEq(helper.satisfies("v1.3.0", "^1.2.0"), true);
        assertEq(helper.satisfies("v2.0.0", "^1.2.0"), false);
        assertEq(helper.satisfies("v1.1.9", "^1.2.0"), false);

        assertEq(helper.satisfies("1.2.3", "~1.2.0"), true);
        assertEq(helper.satisfies("1.3.0", "~1.2.0"), false);
    });

    it("should satisfy exact version constraints", fn() {
        let helper = SemverHelper();
        assertEq(helper.satisfies("v1.2.3", "1.2.3"), true);
        assertEq(helper.satisfies("v1.2.4", "1.2.3"), false);
    });

    it("should compare semver correctly", fn() {
        let helper = SemverHelper();
        assert(helper.compareSemver("1.2.3", "1.2.4") < 0);
        assert(helper.compareSemver("2.0.0", "1.9.9") > 0);
        assertEq(helper.compareSemver("1.0.0", "v1.0.0"), 0);
    });
});
