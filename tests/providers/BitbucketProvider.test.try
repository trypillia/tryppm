load "../../src/SemverTrait.try";
load "../../src/BitbucketProvider.try";
use TrypPM.Providers.BitbucketProvider;

let depsCalledFlag = false;

class MockInstaller {
    fn installDeps(deps, replaceMap, installedMap) {
        depsCalledFlag = true;
    }
}

class MockFile {
    fn read() {
        let map = {"dependencies": {"some-dep": "1.0.0"}};
        return MockResult.ok(Json.stringify(map));
    }
    fn close() {}
}

let originalOsExec = OS.exec;
let originalFileExists = File.exists;
let originalFileOpen = File.open;
let originalHttpGet = Http.get;

describe("BitbucketProvider", fn() {
    let mockExecLog = [];
    
    beforeEach(fn() {
        mockExecLog = [];
        
        OS.exec = fn(cmd) {
            List.push(mockExecLog, cmd);
            return MockResult.ok("");
        };

        File.exists = fn(path) {
            return path == "_test_target_dir/hello-world/tryp.json";
        };

        File.open = fn(path, mode) {
            return MockResult.ok(MockFile());
        };

        Http.get = fn(url) {
            if (url == "https://api.bitbucket.org/2.0/repositories/user/hello-world/refs/tags") {
                let tags = {
                    "values": [
                        {"name": "v0.9.0"},
                        {"name": "v1.0.0"},
                        {"name": "v1.1.0"},
                        {"name": "v2.0.0"}
                    ]
                };
                return MockResult.ok(Json.stringify(tags));
            } else if (url == "https://api.bitbucket.org/2.0/repositories/user/hello-world/refs/tags?sort=-target.date") {
                let tags = {
                    "values": [
                        {"name": "v2.0.0"}
                    ]
                };
                return MockResult.ok(Json.stringify(tags));
            } else if (url == "https://api.bitbucket.org/2.0/repositories/this-repo-should-never-exist-xyz123/test/refs/tags" || url == "https://api.bitbucket.org/2.0/repositories/this-repo-should-never-exist-xyz123/test/refs/tags?sort=-target.date") {
                return MockResult.err("");
            }
            return MockResult.err("");
        };
    });

    afterEach(fn() {
        OS.exec = originalOsExec;
        File.exists = originalFileExists;
        File.open = originalFileOpen;
        Http.get = originalHttpGet;
    });

    it("should support bitbucket: prefix", fn() {
        let p = BitbucketProvider();
        assertEq(p.supports("bitbucket:user/hello-world"), true);
        assertEq(p.supports("github:octocat/Hello-World"), false);
    });

    it("should resolve version 'latest' to a tag or master", fn() {
        let p = BitbucketProvider();
        let ver = p.resolveVersion("bitbucket:user/hello-world", "latest");
        assertEq(ver, "v2.0.0");
    });

    it("should resolve version with caret constraint", fn() {
        let p = BitbucketProvider();
        let ver = p.resolveVersion("bitbucket:user/hello-world", "^1.0.0");
        assertEq(ver, "v1.1.0");
    });

    it("should fallback to requested version for unknown repo", fn() {
        let p = BitbucketProvider();
        let ver = p.resolveVersion("bitbucket:this-repo-should-never-exist-xyz123/test", "latest");
        assertEq(ver, "master");
    });

    it("should fallback to requested version if tags fetch fails or no tags match", fn() {
        let p = BitbucketProvider();
        let ver = p.resolveVersion("bitbucket:this-repo-should-never-exist-xyz123/test", "^99.0.0");
        assertEq(ver, "^99.0.0");
    });

    it("should install package via git clone", fn() {
        let p = BitbucketProvider();
        let installer = MockInstaller();
        depsCalledFlag = false;
        
        let res = p.install("bitbucket:user/hello-world", "master", "_test_target_dir", {}, {}, installer);
        
        assertEq(res, true);
        assertEq(mockExecLog[0], "rm -rf _test_target_dir/hello-world");
        assertEq(mockExecLog[1], "git clone --depth 1 --branch master https://bitbucket.org/user/hello-world.git _test_target_dir/hello-world");
        assertEq(depsCalledFlag, true);
    });

    it("should return false and print error if git clone fails", fn() {
        let p = BitbucketProvider();
        OS.exec = fn(cmd) {
            return MockResult.err("");
        };
        let res = p.install("bitbucket:user/hello-world", "master", "_test_target_dir", {}, {}, MockInstaller());
        assertEq(res, false);
    });
});
