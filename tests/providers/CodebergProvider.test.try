load "../../src/SemverTrait.try";
load "../../src/CodebergProvider.try";
use TrypPM.Providers.CodebergProvider;

let depsCalledFlag = false;

class MockInstaller {
    fn installDeps(deps, replaceMap, installedMap) {
        depsCalledFlag = true;
    }
}

class MockResult {
    let isOk;
    let value;
    fn init(isOk, value) {
        this.isOk = isOk;
        this.value = value;
    }
}

class MockFile {
    fn read() {
        let map = {"dependencies": {"some-dep": "1.0.0"}};
        return MockResult(true, Json.stringify(map));
    }
    fn close() {}
}

let originalOsExec = OS.exec;
let originalFileExists = File.exists;
let originalFileOpen = File.open;
let originalHttpGet = Http.get;

describe("CodebergProvider", fn() {
    let mockExecLog = [];
    
    beforeEach(fn() {
        mockExecLog = [];
        
        OS.exec = fn(cmd) {
            List.push(mockExecLog, cmd);
            return MockResult(true, "");
        };

        File.exists = fn(path) {
            return path == "_test_target_dir/hello-world/tryp.json";
        };

        File.open = fn(path, mode) {
            return MockResult(true, MockFile());
        };

        Http.get = fn(url) {
            if (url == "https://codeberg.org/api/v1/repos/user/hello-world/tags") {
                let tags = [
                    {"name": "v0.9.0"},
                    {"name": "v1.0.0"},
                    {"name": "v1.1.0"},
                    {"name": "v2.0.0"}
                ];
                return MockResult(true, Json.stringify(tags));
            } else if (url == "https://codeberg.org/api/v1/repos/user/hello-world/releases/latest") {
                return MockResult(true, Json.stringify({"tag_name": "v2.0.0"}));
            } else if (url == "https://codeberg.org/api/v1/repos/this-repo-should-never-exist-xyz123/test/tags" || url == "https://codeberg.org/api/v1/repos/this-repo-should-never-exist-xyz123/test/releases/latest") {
                return MockResult(false, "");
            }
            return MockResult(false, "");
        };
    });

    afterEach(fn() {
        OS.exec = originalOsExec;
        File.exists = originalFileExists;
        File.open = originalFileOpen;
        Http.get = originalHttpGet;
    });

    it("should support codeberg: prefix", fn() {
        let p = CodebergProvider();
        assertEq(p.supports("codeberg:user/hello-world"), true);
        assertEq(p.supports("github:octocat/Hello-World"), false);
    });

    it("should resolve version 'latest' to a tag or main", fn() {
        let p = CodebergProvider();
        let ver = p.resolveVersion("codeberg:user/hello-world", "latest");
        assertEq(ver, "v2.0.0");
    });

    it("should resolve version with caret constraint", fn() {
        let p = CodebergProvider();
        let ver = p.resolveVersion("codeberg:user/hello-world", "^1.0.0");
        assertEq(ver, "v1.1.0");
    });

    it("should fallback to requested version for unknown repo", fn() {
        let p = CodebergProvider();
        let ver = p.resolveVersion("codeberg:this-repo-should-never-exist-xyz123/test", "latest");
        assertEq(ver, "main");
    });

    it("should install package via git clone", fn() {
        let p = CodebergProvider();
        let installer = MockInstaller();
        depsCalledFlag = false;
        
        let res = p.install("codeberg:user/hello-world", "master", "_test_target_dir", {}, {}, installer);
        
        assertEq(res, true);
        assertEq(mockExecLog[0], "rm -rf _test_target_dir/hello-world");
        assertEq(mockExecLog[1], "git clone --depth 1 --branch master https://codeberg.org/user/hello-world.git _test_target_dir/hello-world");
        assertEq(depsCalledFlag, true);
    });
});
