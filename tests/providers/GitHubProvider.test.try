load "../../src/GitHubProvider.try";
use TrypPM.Providers.GitHubProvider;

class MockInstaller {
    fn installDeps(deps, replaceMap, installedMap) {
        this.depsCalled = true;
    }
}

describe("GitHubProvider", fn() {
    after(fn() {
        OS.exec("rm -rf _test_target_dir");
    });

    it("should support github: prefix", fn() {
        let p = GitHubProvider();
        assertEq(p.supports("github:octocat/Hello-World"), true);
        assertEq(p.supports("local:../path"), false);
    });

    it("should resolve version 'latest' to a tag or main", fn() {
        let p = GitHubProvider();
        let ver = p.resolveVersion("github:octocat/Hello-World", "latest");
        assert(String.length(ver) > 0);
    });

    it("should resolve version with caret constraint", fn() {
        let p = GitHubProvider();
        // Just checking if it runs without crashing, since we don't know exact tags
        let ver = p.resolveVersion("github:octocat/Hello-World", "^1.0.0");
        assert(String.length(ver) > 0);
    });

    it("should fallback to main for unknown repo", fn() {
        let p = GitHubProvider();
        let ver = p.resolveVersion("github:this-repo-should-never-exist-xyz123/test", "latest");
        assertEq(ver, "main");
    });

    it("should install package via git clone", fn() {
        let p = GitHubProvider();
        let installer = MockInstaller();
        installer.depsCalled = false;
        
        OS.exec("mkdir -p _test_target_dir");
        let res = p.install("github:octocat/Hello-World", "master", "_test_target_dir", {}, {}, installer);
        
        assertEq(res, true);
        assertEq(File.exists("_test_target_dir/Hello-World/README"), true);
    });
});
