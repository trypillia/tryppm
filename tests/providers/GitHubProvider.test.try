load "../../src/SemverTrait.try";
load "../../src/GitHubProvider.try";
use TrypPM.Providers.GitHubProvider;

let depsCalledFlag = false;

class MockInstaller {
    fn installDeps(deps, replaceMap, installedMap) {
        depsCalledFlag = true;
    }
}

class MockResult {
    let isOk;
    let value;
    fn init(isOk, value) {
        this.isOk = isOk;
        this.value = value;
    }
}

class MockFile {
    fn read() {
        let map = {"dependencies": {"some-dep": "1.0.0"}};
        return MockResult(true, Json.stringify(map));
    }
    fn close() {}
}

let originalOsExec = OS.exec;
let originalFileExists = File.exists;
let originalFileOpen = File.open;
let originalHttpGet = Http.get;

describe("GitHubProvider", fn() {
    let mockExecLog = [];
    
    beforeEach(fn() {
        mockExecLog = [];
        
        OS.exec = fn(cmd) {
            List.push(mockExecLog, cmd);
            return MockResult(true, "");
        };

        File.exists = fn(path) {
            return path == "_test_target_dir/Hello-World/tryp.json";
        };

        File.open = fn(path, mode) {
            return MockResult(true, MockFile());
        };

        Http.get = fn(url) {
            if (url == "https://api.github.com/repos/octocat/Hello-World/tags") {
                let tags = [
                    {"name": "v0.9.0"},
                    {"name": "v1.0.0"},
                    {"name": "v1.1.0"},
                    {"name": "v2.0.0"}
                ];
                return MockResult(true, Json.stringify(tags));
            } else if (url == "https://api.github.com/repos/octocat/Hello-World/releases/latest") {
                return MockResult(true, Json.stringify({"tag_name": "v2.0.0"}));
            } else if (url == "https://api.github.com/repos/this-repo-should-never-exist-xyz123/test/tags" || url == "https://api.github.com/repos/this-repo-should-never-exist-xyz123/test/releases/latest") {
                let errorResponse = {"message": "Not Found", "documentation_url": "..."};
                return MockResult(true, Json.stringify(errorResponse));
            }
            return MockResult(false, "");
        };
    });

    afterEach(fn() {
        OS.exec = originalOsExec;
        File.exists = originalFileExists;
        File.open = originalFileOpen;
        Http.get = originalHttpGet;
    });

    it("should support github: prefix", fn() {
        let p = GitHubProvider();
        assertEq(p.supports("github:octocat/Hello-World"), true);
        assertEq(p.supports("local:../path"), false);
    });

    it("should resolve version 'latest' to a tag or main", fn() {
        let p = GitHubProvider();
        let ver = p.resolveVersion("github:octocat/Hello-World", "latest");
        assertEq(ver, "v2.0.0");
    });

    it("should resolve version with caret constraint", fn() {
        let p = GitHubProvider();
        let ver = p.resolveVersion("github:octocat/Hello-World", "^1.0.0");
        assertEq(ver, "v1.1.0");
    });

    it("should fallback to requested version for unknown repo", fn() {
        let p = GitHubProvider();
        let ver = p.resolveVersion("github:this-repo-should-never-exist-xyz123/test", "latest");
        // Our API returns Not Found, so it falls back to "main"
        assertEq(ver, "main");
    });

    it("should install package via git clone", fn() {
        let p = GitHubProvider();
        depsCalledFlag = false;
        let res = p.install("github:octocat/Hello-World", "v1.0.0", "_test_target_dir", {}, {}, MockInstaller());
        assertEq(res, true);
        
        let len = List.length(mockExecLog);
        assertEq(len, 2);
        assertEq(mockExecLog[0], "rm -rf _test_target_dir/Hello-World");
        assertEq(mockExecLog[1], "git clone --depth 1 --branch v1.0.0 https://github.com/octocat/Hello-World.git _test_target_dir/Hello-World");
        
        assertEq(depsCalledFlag, true);
    });

    it("should return false and print error if git clone fails", fn() {
        let p = GitHubProvider();
        OS.exec = fn(cmd) {
            return MockResult(false, "");
        };
        let res = p.install("github:octocat/Hello-World", "v1.0.0", "_test_target_dir", {}, {}, MockInstaller());
        assertEq(res, false);
    });
});
