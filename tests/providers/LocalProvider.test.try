load "../../src/LocalProvider.try";
use TrypPM.Providers.LocalProvider;

let depsCalledFlag = false;

class MockInstaller {
    fn installDeps(deps, replaceMap, installedMap) {
        depsCalledFlag = true;
    }
}

// Backup original native methods
let originalOsExec = OS.exec;
let originalFileExists = File.exists;
let originalFileOpen = File.open;

class MockFile {
    fn read() {
        let map = {"dependencies": {"some-dep": "1.0.0"}};
        return MockResult.ok(Json.stringify(map));
    }
    fn close() {}
}

describe("LocalProvider", fn() {
    let mockExecLog = [];
    
    beforeEach(fn() {
        mockExecLog = [];
        
        // Mock OS.exec to record commands and always return success
        OS.exec = fn(cmd) {
            List.push(mockExecLog, cmd);
            return MockResult.ok("");
        };

        File.exists = fn(path) {
            return path == "_test_local_pkg/tryp.json" || path == "_test_local_pkg//tryp.json";
        };
        
        File.open = fn(path, mode) {
            return MockResult.ok(MockFile());
        };
    });

    afterEach(fn() {
        // Restore original methods
        OS.exec = originalOsExec;
        File.exists = originalFileExists;
        File.open = originalFileOpen;
    });

    it("should support local: prefix", fn() {
        let p = LocalProvider();
        assertEq(p.supports("local:../path"), true);
        assertEq(p.supports("github:User/Repo"), false);
        assertEq(p.supports("local"), false);
    });

    it("should resolve version to LOCAL", fn() {
        let p = LocalProvider();
        assertEq(p.resolveVersion("local:path", "1.0.0"), "LOCAL");
    });

    it("should copy local directory and call installDeps", fn() {
        let p = LocalProvider();
        let installer = MockInstaller();
        depsCalledFlag = false;
        
        let res = p.install("local:_test_local_pkg", "LOCAL", "_test_target_dir", {}, {}, installer);
        assertEq(res, true);
        
        assertEq(mockExecLog[0], "rm -rf _test_target_dir/_test_local_pkg");
        assertEq(mockExecLog[1], "cp -r _test_local_pkg _test_target_dir/_test_local_pkg");
        assertEq(depsCalledFlag, true);
    });

    it("should handle trailing slash in local path", fn() {
        let p = LocalProvider();
        let installer = MockInstaller();
        depsCalledFlag = false;
        
        let res = p.install("local:_test_local_pkg/", "LOCAL", "_test_target_dir", {}, {}, installer);
        assertEq(res, true);
        assertEq(mockExecLog[1], "cp -r _test_local_pkg/ _test_target_dir/_test_local_pkg");
    });

    it("should fail if path is invalid", fn() {
        let p = LocalProvider();
        
        // Mock OS.exec to fail for this test
        OS.exec = fn(cmd) { return MockResult.err(""); };
        
        let res = p.install("local:_invalid_path_that_doesnt_exist", "LOCAL", "_test_target_dir", {}, {}, nil);
        assertEq(res, false);
    });
});
